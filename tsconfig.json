{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "*": ["node_modules/*"]
    },
    "declaration": true
  },
  "include": [
    "src/**/*",
    "renderer/App.tsx",
    "main/renderer/main.ts",
    "main/renderer/tooltip.ts",
    "main/preloads/tooltip.ts",
    "main/preloads/main.ts",
    "main/index.ts",
    "assets.d.ts"
  ]
}
